# CLIProxyAPI configuration written by grokbot-cpa install.sh (box scheme).
# Bound to localhost; public access goes through the named Cloudflare tunnel, tailnet access via `tailscale serve`.
host: "127.0.0.1"
port: @PORT@

remote-management:
  # false: management API/panel only from localhost. Set true only if you really need remote management.
  allow-remote: @ALLOW_REMOTE@
  # Hashed by CLIProxyAPI on startup; the plaintext copy is $CPA_DIR/secrets/management-secret.
  secret-key: "@MGMT_SECRET@"
  disable-control-panel: false
  # Management panel from the 7iook fork (subscription/quota cockpit). The first missing management.html is still
  # fetched from this repo's latest release; periodic background re-downloads are off so a hand-deployed
  # $CPA_DIR/static/management.html is never overwritten.
  disable-auto-update-panel: true
  panel-github-repository: "https://github.com/7iook/Cli-Proxy-API-Management-Center"

# OAuth credentials (claude-<account>.json, ...).
auth-dir: "@AUTH_DIR@"

# Clients send one of these as "Authorization: Bearer <key>". Copy: $CPA_DIR/secrets/client-api-key
# (healthcheck.sh / refresh-model-catalog.sh read that file).
api-keys:
  - "@API_KEY@"

# Plugins (installed by install-plugins.sh: claude-keep-rolling, cpa-key-billing, usage-dashboard-zduu,
# claude-cache-keepalive). The zduu registry provides "用量统计" (usage-dashboard-zduu).
plugins:
  enabled: true
  dir: "plugins"
  store-sources:
    - "https://raw.githubusercontent.com/zduu/cpa-usage-plugin/main/registry.json"

debug: false
logging-to-file: false
usage-statistics-enabled: false
request-retry: 3
