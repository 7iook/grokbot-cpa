# grokbot-cpa "box" profile settings. install-box.sh copies this to ~/.config/grokbot-cpa/box.env
# (sourced by every box/ and keepalive/ script, including daemons started with a clean env).
# NO secrets here: the Tailscale auth key lives in $TS_DIR/authkey (chmod 600), the Cloudflare
# tunnel credentials in $CPA_DIR/cloudflared/<tunnel-id>.json, API keys in $CPA_DIR/config.yaml.

CPA_DIR="$HOME/cli-proxy-api"          # CPA install (bin/, config.yaml, cloudflared/, logs/)
CPA_PORT=8317
CF_TUNNEL=cpa                          # cloudflared named tunnel (config: $CPA_DIR/cloudflared/config.yml)
CF_HOSTNAME=""                         # public hostname routed to the tunnel, e.g. api.example.com
TS_DIR=/workspace/tailscale            # tailscaled binaries + state + authkey file
TS_HOSTNAME=cpa-box                    # tailnet device name
BOOT_SERVICES="$HOME/boot-services.sh"
CPA_BOOTSTRAP=/workspace/cpa-bootstrap.sh
LOG_TZ=Asia/Shanghai                   # fixed timezone for log lines
ACTIVITY_DIR="$HOME/box-activity-test" # box-activity keepalive (Chrome profile + logs)

# CPA binary: build the custom fork from source (default) or download the upstream release.
CPA_BUILD=source                       # source | release
CPA_SOURCE_REPO=https://github.com/7iook/CLIProxyAPI.git
CPA_SOURCE_REF=feat/claude-setup-token-quota   # or main, a tag, or a commit (93057ab0 = 2026-10-21 head)
CPA_SRC_DIR="$HOME/build/cpa"
CPA_VERSION=v8.0.29                    # release fallback / version label

# CPA plugins installed right after CPA (box/cpa/install-plugins.sh; opt out: install.sh --no-plugins).
# "id@version" from the plugin stores (official + zduu registry). Lamplighter is deliberately not installed.
CPA_PLUGINS="claude-keep-rolling@0.2.4 cpa-key-billing@1.4.0 usage-dashboard-zduu@2.7.5"
CACHE_KEEPALIVE=1                       # 缓存保活 (claude-cache-keepalive), built from source (needs Go + gcc)
CACHE_KEEPALIVE_REPO=https://github.com/Banben07/cpa_claude_cache_keep.git
CACHE_KEEPALIVE_REF=9b8637d             # 0.8.12
