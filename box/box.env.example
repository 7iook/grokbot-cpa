# grokbot-cpa "box" profile settings. install-box.sh copies this to ~/.config/grokbot-cpa/box.env
# (sourced by every box/ and keepalive/ script, including daemons started with a clean env).
# NO secrets here. Secrets live in files under PERSIST_ROOT (see README "Where secrets live").
#
# PERSISTENCE: on a Grok Bot box only /home/box survives a reboot/reset. /workspace, /usr, /etc, /opt and apt
# packages can be wiped (observed: a fresh /workspace/tailscale dir vanished after a reboot, $HOME survived).
# So every binary, config, secret, state file, plugin and browser lives under PERSIST_ROOT; apt packages are
# re-ensured by boot-services.sh on every start (BOOT_APT_PKGS).
PERSIST_ROOT="$HOME"

CPA_DIR="$PERSIST_ROOT/cli-proxy-api"  # bin/ (cli-proxy-api, cloudflared), config.yaml, secrets/, auths/, plugins/, cloudflared/, logs/
CPA_PORT=8317
CF_TUNNEL=cpa                          # cloudflared named tunnel name (created/reused by cf-setup.sh)
CF_HOSTNAME=""                         # public hostname for CPA, e.g. api.example.com (zone must be on the CF account)
TS_DIR="$PERSIST_ROOT/tailscale"       # tailscale/tailscaled binaries, tailscaled.state, authkey
TS_HOSTNAME=cpa-box                    # tailnet device name
TS_SSH=1                               # enable Tailscale SSH (tailscale up --ssh)
BOOT_SERVICES="$PERSIST_ROOT/boot-services.sh"
CPA_BOOTSTRAP="$PERSIST_ROOT/cpa-bootstrap.sh"
LOG_TZ=Asia/Shanghai                   # fixed timezone for log lines
ACTIVITY_DIR="$PERSIST_ROOT/box-activity-test" # box-activity keepalive (Chrome profile + logs)
CMCC_DIR="$PERSIST_ROOT/cmcc-cloud-alive"
# apt packages re-installed at boot if missing (system dirs are not persistent)
BOOT_APT_PKGS="curl jq openssl ca-certificates tar procps iproute2 python3 python3-venv util-linux git gcc openssh-client xdg-utils libgtk-3-0 libnotify4 libnss3 libxss1 libxtst6 libsecret-1-0 libgbm1"

# Fingerprint browsers (extracted .deb under PERSIST_ROOT, not dpkg-installed; profiles in ~/.config/*)
ADSPOWER_DIR="$PERSIST_ROOT/adspower"
ADSPOWER_URL=""                        # empty = newest linux-x64-global .deb scraped from https://www.adspower.com/download
ROXY_DIR="$PERSIST_ROOT/roxybrowser"
ROXY_URL=https://dl.roxybrowser.com/app-download/Linux-64-latest   # official "latest" redirect (verified 2026-10-21 -> 4.0.8)

# CPA binary: build the custom fork from source (default) or download the upstream release.
CPA_BUILD=source                       # source | release
CPA_SOURCE_REPO=https://github.com/7iook/CLIProxyAPI.git
CPA_SOURCE_REF=feat/claude-setup-token-quota   # or main, a tag, or a commit (93057ab0 = 2026-10-21 head)
CPA_SRC_DIR="$PERSIST_ROOT/build/cpa"
GO_ROOT="$PERSIST_ROOT/.local/go"           # Go toolchain for source builds
CPA_VERSION=v8.0.29                    # release fallback / version label

# CPA plugins installed right after CPA (box/cpa/install-plugins.sh; opt out: install.sh --no-plugins).
# "id@version" from the plugin stores (official + zduu registry). Lamplighter is deliberately not installed.
CPA_PLUGINS="claude-keep-rolling@0.2.4 cpa-key-billing@1.4.0 usage-dashboard-zduu@2.7.5"
CACHE_KEEPALIVE=1                       # 缓存保活 (claude-cache-keepalive), built from source (needs Go + gcc)
CACHE_KEEPALIVE_REPO=https://github.com/Banben07/cpa_claude_cache_keep.git
CACHE_KEEPALIVE_REF=9b8637d             # 0.8.12
COPYIN_WAIT=900                        # boot-services.sh waits up to N s for the platform home restore (/tmp/sand-copy-in-status.json)
