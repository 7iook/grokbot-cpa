# grokbot-cpa settings. install.sh writes the real file to $INSTALL_DIR/cpa.env.
# Any of these can also be passed as environment variables to install.sh; re-running install.sh
# keeps existing values unless you override them.

# Where binaries, scripts, config, pid files and logs live.
INSTALL_DIR="$HOME/cli-proxy-api"
# Local CLIProxyAPI port (bound to 127.0.0.1).
PORT=8317
# Tunnel connector N exposes /ready and /metrics on 127.0.0.1:(METRICS_BASE+N).
METRICS_BASE=20250
# OAuth credential directory (shared by every CLIProxyAPI using it).
AUTH_DIR="$HOME/.cli-proxy-api"
# named = your own Cloudflare tunnel token + hostname, 2 connectors (stable URL)
# quick = trycloudflare.com quick tunnel, 1 connector, random URL that changes on restart (trial)
# none  = local only
TUNNEL_MODE=quick
# named mode: the public hostname you routed to http://localhost:$PORT in the Cloudflare dashboard.
PUBLIC_URL=""
# http2 (default; most robust behind proxies) or quic.
TUNNEL_PROTOCOL=http2
# auto (detect fake-IP DNS), 1 (force), 0 (off).
HOSTS_WORKAROUND=auto
# true opens the management API to the internet through the tunnel. Not recommended.
ALLOW_REMOTE=false
